[org/gnome/shell]
enabled-extensions=["dash-to-panel@jderose9.github.com", "ubuntu-appindicators@ubuntu.com", "blur-my-shell@aunetx", "arcmenu@arcmenu.com", "user-theme@gnome-shell-extensions.gcampax.github.com", "ding@rastersoft.com"]
disable-user-extensions=false
disable-extension-version-validation=false
favorite-apps=["org.gnome.Nautilus.desktop", "firefox-esr.desktop", "onlyoffice-desktopeditors.desktop", "org.gnome.Geary.desktop", "org.gnome.Rhythmbox3.desktop", "org.gnome.Settings.desktop", "org.gnome.Software.desktop", "org.gnome.Boxes.desktop", "virt-manager.desktop"]

[org/gnome/desktop/interface]
gtk-theme="ZorinBlue-Dark"
icon-theme="ZorinBlue-Dark"
color-scheme="prefer-dark"

[org/gnome/desktop/wm/preferences]
button-layout="appmenu:minimize,maximize,close"

[org/gnome/desktop/background]
picture-uri="file:///usr/share/backgrounds/mannindustries/mi_linux_04_studio_one_3840x2160.jpg"
picture-uri-dark="file:///usr/share/backgrounds/mannindustries/mi_linux_04_studio_one_3840x2160.jpg"
picture-options="zoom"

[org/gnome/desktop/screensaver]
picture-uri="file:///usr/share/backgrounds/mannindustries/mi_linux_04_studio_one_3840x2160.jpg"

[org/gnome/shell/extensions/dash-to-panel]
panel-position="BOTTOM"
panel-size=36
trans-use-custom-opacity=true
trans-panel-opacity=0.28
trans-use-custom-bg=true
trans-bg-color="#1d1d1f"
trans-use-dynamic-opacity=false
trans-use-border=false
appicon-margin=4
appicon-padding=6
leftbox-padding=7

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
brightness=0.72
sigma=28
static-blur=true
override-background=true
corner-radius=0

[org/gnome/shell/extensions/arcmenu]
menu-button-icon="/usr/share/icons/hicolor/256x256/apps/mannindustries-menu-emblem.png"
menu-button-appearance="Icon_Text"
menu-button-text="Linux"
menu-button-icon-size=30
menu-layout="windows"
position-in-panel="Left"
force-menu-location="BottomLeft"
show-activities-button=false
gnome-dash-show-applications=false
override-menu-theme=true
menu-background-color="rgba(20,20,22,0.42)"
menu-border-color="rgba(255,255,255,0.18)"
menu-separator-color="rgba(255,255,255,0.1)"
menu-item-hover-bg-color="rgba(21,83,158,0.72)"
menu-item-active-bg-color="rgba(25,98,163,0.78)"
menu-foreground-color="rgb(223,223,223)"
