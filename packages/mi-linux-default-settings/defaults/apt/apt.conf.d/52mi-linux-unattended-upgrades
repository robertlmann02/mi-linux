Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Allow normal Founder-channel MI Linux installs to receive signed MI Linux
// package updates from apt.mannindustries.org during unattended-upgrades.
Unattended-Upgrade::Origins-Pattern:: "origin=Mann Industries,codename=forky-founder,label=MI Linux";
