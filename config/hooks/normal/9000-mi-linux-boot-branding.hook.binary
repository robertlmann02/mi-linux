#!/bin/sh
set -e

# Brand the USB/ISO boot menu so users see MI Linux, not generic Debian/Forky labels.
# live-build can execute binary hooks from different working directories, so resolve
# the generated binary tree and source asset directory defensively.
BINARY_DIR=""
for candidate in binary ../binary ../../binary ../../../binary; do
    if [ -d "$candidate" ]; then
        BINARY_DIR="$candidate"
        break
    fi
done

ASSET_DIR=""
for candidate in assets ../assets ../../assets ../../../assets; do
    if [ -d "$candidate" ]; then
        ASSET_DIR="$candidate"
        break
    fi
done

if [ -z "$BINARY_DIR" ]; then
    echo "MI Linux boot branding: binary tree not present yet; skipping without failing."
    exit 0
fi

if [ -d "$BINARY_DIR/boot/grub" ]; then
    if [ -n "$ASSET_DIR" ] && [ -f "$ASSET_DIR/mi-linux-boot-splash.png" ]; then
        mkdir -p "$BINARY_DIR/boot/grub"
        cp "$ASSET_DIR/mi-linux-boot-splash.png" "$BINARY_DIR/boot/grub/splash.png"
    fi
    if [ -f "$BINARY_DIR/boot/grub/grub.cfg" ]; then
        sed -i \
          -e 's/menuentry "Live system (amd64)"/menuentry "Try or Install MI Linux"/' \
          -e 's/menuentry "Live system (amd64 fail-safe mode)"/menuentry "MI Linux safe graphics mode"/' \
          -e "s|submenu 'Utilities\.\.\.'|submenu 'MI Linux utilities...'|" \
          -e 's/Verify integrity of the boot medium/Verify MI Linux install media/' \
          -e 's/Debian GNU\/Linux/MI Linux/g' \
          -e 's/Debian/MI Linux/g' \
          -e 's/Forky Founder/Founder Preview/g' \
          "$BINARY_DIR/boot/grub/grub.cfg"
        if ! grep -q 'MI Linux Founder Preview boot menu' "$BINARY_DIR/boot/grub/grub.cfg"; then
            tmp=$(mktemp)
            {
                echo '# MI Linux Founder Preview boot menu'
                echo 'insmod all_video'
                echo 'insmod gfxterm'
                echo 'loadfont /boot/grub/unicode.pf2'
                echo 'set gfxmode=auto'
                echo 'terminal_output gfxterm'
                echo 'background_image /boot/grub/splash.png'
                echo 'set menu_color_normal=white/black'
                echo 'set menu_color_highlight=black/light-cyan'
                echo ''
                cat "$BINARY_DIR/boot/grub/grub.cfg"
            } > "$tmp"
            mv "$tmp" "$BINARY_DIR/boot/grub/grub.cfg"
        fi
    fi
fi

if [ -d "$BINARY_DIR/isolinux" ]; then
    if [ -n "$ASSET_DIR" ] && [ -f "$ASSET_DIR/mi-linux-boot-splash-640x480.png" ]; then
        # Syslinux/ISOLINUX draws its Debian title from this background image,
        # so replace it directly; text substitutions alone are not enough.
        cp "$ASSET_DIR/mi-linux-boot-splash-640x480.png" "$BINARY_DIR/isolinux/splash.png"
    elif [ -n "$ASSET_DIR" ] && [ -f "$ASSET_DIR/mi-linux-boot-splash.png" ]; then
        cp "$ASSET_DIR/mi-linux-boot-splash.png" "$BINARY_DIR/isolinux/splash.png"
    fi
    if [ -f "$BINARY_DIR/isolinux/menu.cfg" ]; then
        sed -i \
          -e 's/menu title Boot menu/menu title MI Linux Founder Preview/' \
          -e 's/menu label \^Utilities/menu label ^MI Linux utilities/' \
          -e 's/menu title Utilities/menu title MI Linux utilities/' \
          -e 's/Debian GNU\/Linux/MI Linux/g' \
          -e 's/Debian/MI Linux/g' \
          -e 's/Forky Founder/Founder Preview/g' \
          "$BINARY_DIR/isolinux/menu.cfg"
    fi
    if [ -f "$BINARY_DIR/isolinux/stdmenu.cfg" ]; then
        sed -i \
          -e 's/menu vshift 12/menu vshift 14/' \
          -e 's/#76a1d0ff/#075da8ff/g' \
          "$BINARY_DIR/isolinux/stdmenu.cfg"
    fi
    if [ -f "$BINARY_DIR/isolinux/live.cfg" ]; then
        sed -i \
          -e 's/menu label \^Live system.*/menu label ^Try or Install MI Linux/' \
          -e 's/menu label Live system (amd64 fail-safe mode).*/menu label MI Linux safe graphics mode/' \
          -e 's/Debian GNU\/Linux/MI Linux/g' \
          -e 's/Debian/MI Linux/g' \
          -e 's/Forky Founder/Founder Preview/g' \
          "$BINARY_DIR/isolinux/live.cfg"
    fi
fi

find "$BINARY_DIR" -maxdepth 3 -type f \( -name '*.cfg' -o -name '*.txt' \) -exec sed -i \
  -e 's/Debian GNU\/Linux/MI Linux/g' \
  -e 's/Debian/MI Linux/g' \
  -e 's/Forky Founder/Founder Preview/g' {} +

echo "MI Linux boot branding applied to $BINARY_DIR"
