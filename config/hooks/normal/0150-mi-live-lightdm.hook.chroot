#!/bin/sh
set -e

# Prefer GDM for the live ISO because current GNOME Shell is Wayland-first and
# the LightDM Xsession path exits immediately after starting gnome-session.
if command -v systemctl >/dev/null 2>&1; then
    systemctl disable lightdm.service 2>/dev/null || true
    systemctl enable gdm3.service 2>/dev/null || true
fi
printf '/usr/sbin/gdm3\n' > /etc/X11/default-display-manager
