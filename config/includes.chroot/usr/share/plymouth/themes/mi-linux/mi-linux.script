Window.SetBackgroundTopColor(0.01, 0.07, 0.14);
Window.SetBackgroundBottomColor(0.00, 0.02, 0.06);

source_image = Image("mi-linux-boot-splash.png");

fun scaled_splash_image() {
    # Plymouth does not automatically scale script-theme images. Scale the MI
    # Linux boot/shutdown art to the active framebuffer so it fills the screen
    # instead of appearing as a smaller centered image on high-resolution panels.
    return source_image.Scale(Window.GetWidth(), Window.GetHeight());
}

splash = scaled_splash_image();
sprite = Sprite(splash);
sprite.SetX(0);
sprite.SetY(0);
message_sprite = Sprite();

fun refresh_callback() {
    splash = scaled_splash_image();
    sprite.SetImage(splash);
    sprite.SetX(0);
    sprite.SetY(0);
}

Plymouth.SetRefreshFunction(refresh_callback);
