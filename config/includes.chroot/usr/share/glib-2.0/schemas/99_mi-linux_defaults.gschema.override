[org.gnome.desktop.background]
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/mannindustries/mi_linux_carbon_mark_3840x2160.jpg'
picture-uri-dark='file:///usr/share/backgrounds/mannindustries/mi_linux_carbon_mark_3840x2160.jpg'
primary-color='#075da8'
secondary-color='#020817'

[org.gnome.desktop.screensaver]
picture-options='zoom'
picture-uri='file:///var/lib/mi-linux/wallpaper-sync/current-wallpaper.jpg'
primary-color='#075da8'
secondary-color='#020817'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
clock-show-weekday=true
