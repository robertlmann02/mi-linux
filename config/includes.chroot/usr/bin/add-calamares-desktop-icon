#!/bin/sh
set -u

# Ensure the live desktop always gets a visible trusted installer launcher.
# GNOME/DING can start before xdg-user-dirs is ready, so retry briefly.

for _try in 1 2 3 4 5; do
    DESKTOP=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s/Desktop' "$HOME")
    [ -n "$DESKTOP" ] || DESKTOP="$HOME/Desktop"
    mkdir -p "$DESKTOP" 2>/dev/null && break
    sleep 1
done

SOURCE=/usr/share/applications/calamares-install-debian.desktop
TARGET="$DESKTOP/Install MI Linux.desktop"

if [ -f "$SOURCE" ]; then
    cp -f "$SOURCE" "$TARGET"
else
    cat > "$TARGET" <<'LAUNCHER_EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=Install MI Linux
GenericName=MI Linux Installer
Exec=calamares-install-debian
Comment=Install MI Linux Founder Preview to this computer
Keywords=calamares;system;install;mi-linux;installer
Icon=/usr/share/mi-linux/branding/mi-linux-boot-splash.png
Terminal=false
Categories=Qt;System;
StartupWMClass=calamares
StartupNotify=true
LAUNCHER_EOF
fi

chmod 755 "$TARGET"

if command -v gio >/dev/null 2>&1; then
    gio set -t string "$TARGET" metadata::trusted true 2>/dev/null || true
    if command -v sha256sum >/dev/null 2>&1; then
        gio set -t string "$TARGET" metadata::xfce-exe-checksum "$(sha256sum "$TARGET" | awk '{print $1}')" 2>/dev/null || true
    fi
fi

touch "$TARGET"

if [ -x /usr/bin/calamares ]; then
    ionice -c 3 cat /usr/bin/calamares >/dev/null 2>&1 || true
    ldd /usr/bin/calamares 2>/dev/null | awk '/=> \/[^ ]+/ {print $3}' | while read -r file; do
        [ -r "$file" ] && ionice -c 3 cat "$file" >/dev/null 2>&1 || true
    done
fi
